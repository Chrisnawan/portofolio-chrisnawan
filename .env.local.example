# Salin file ini jadi ".env.local" lalu isi nilainya. ".env.local" tidak ikut di-commit ke git.

# Connection string dari Neon / Vercel Postgres (Storage -> Create Postgres -> .env.local tab)
DATABASE_URL=

# String acak panjang untuk menandatangani session admin.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
